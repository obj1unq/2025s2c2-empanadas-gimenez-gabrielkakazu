import empleados.*

test "punto1: Finanzas de  galvan" {

   assert.equals(0, galvan.deuda()) 	
   assert.equals(0, galvan.dinero()) 	
   assert.equals(15000, galvan.sueldo()) 	

   galvan.gastar(4000)
   assert.equals(4000, galvan.deuda()) 	
   assert.equals(0, galvan.dinero()) 	
   
   galvan.gastar(8000)
   assert.equals(12000, galvan.deuda()) 	
   assert.equals(0, galvan.dinero()) 	

   gimenez.pagarA(galvan)   
   assert.equals(0, galvan.deuda()) 	
   assert.equals(3000, galvan.dinero()) 	

   galvan.gastar(25000)
   assert.equals(22000, galvan.deuda()) 	
   assert.equals(0, galvan.dinero()) 	

   gimenez.pagarA(galvan)   
   assert.equals(7000, galvan.deuda()) 	
   assert.equals(0, galvan.dinero()) 	
}

  test "validacion de fondos insuficientes de gimenez" {
  gimenez.dinero(100)
  assert.that(gimenez.dinero() < galvan.sueldo())
  assert.throwsException({ gimenez.pagarA(galvan) })  

  gimenez.dinero(15000)
  assert.that(gimenez.dinero() >= galvan.sueldo())
  gimenez.pagarA(galvan)
  assert.equals(0, gimenez.dinero())
  assert.throwsException({ gimenez.pagarA(galvan) })  
  }
